# =======================================================
# LUMEN MARKETPLACE - PRODUCTION ENVIRONMENT CONFIGURATION
# =======================================================
# These public variables are ready to copy directly into Vercel 
# (Vercel Project Settings -> Environment Variables)

# Deployed Sepolia Smart Contract Address
NEXT_PUBLIC_CONTRACT_ADDRESS=0x5174834847044b64Ecb0C3f87b823E75153D357f

# Ethereum Sepolia Chain ID (11155111)
NEXT_PUBLIC_CHAIN_ID=11155111

# Reliable Public Sepolia RPC Endpoint
NEXT_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# RainbowKit / WalletConnect Cloud Project ID
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=61a7616e4060102c0fb444f60b680343

# Optional: Alchemy API Key (Leave blank to use public RPCs)
NEXT_PUBLIC_ALCHEMY_API_KEY=
